"use client"

import { useRef, useEffect } from "react"
import Image from "next/image"
import { motion, useScroll, useTransform, useMotionValue } from "framer-motion"

export default function LandingSection() {
  const sectionRef = useRef<HTMLDivElement>(null)
  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end start"],
  })
  
  // Mouse parallax effect values
  const mouseX = useMotionValue(0)
  const mouseY = useMotionValue(0)
  
  // Mouse move handler
  useEffect(() => {
    const handleMouseMove = (e: MouseEvent) => {
      const centerX = window.innerWidth / 2
      const centerY = window.innerHeight / 2
      mouseX.set((e.clientX - centerX) / 20) // Reduced sensitivity
      mouseY.set((e.clientY - centerY) / 20) // Reduced sensitivity
    }
    
    window.addEventListener("mousemove", handleMouseMove)
    return () => window.removeEventListener("mousemove", handleMouseMove)
  }, [mouseX, mouseY])

  // Parallax transforms
  const backgroundY = useTransform(scrollYProgress, [0, 1], ["0%", "30%"])
  const logoY = useTransform(scrollYProgress, [0, 1], ["0%", "50%"])
  const buttonY = useTransform(scrollYProgress, [0, 1], ["0%", "80%"])

  // Opacity transforms
  const logoOpacity = useTransform(scrollYProgress, [0, 0.6], [1, 0])
  const buttonOpacity = useTransform(scrollYProgress, [0, 0.8], [1, 0])

  // Scale transform
  const logoScale = useTransform(scrollYProgress, [0, 1], [1, 0.8])
  
  // Mouse parallax transforms
  const logoX = useTransform(mouseX, [-25, 25], ["5px", "-5px"])
  const logoY2 = useTransform(mouseY, [-25, 25], ["5px", "-5px"])
  const patternX = useTransform(mouseX, [-25, 25], ["10px", "-10px"])
  const patternY = useTransform(mouseY, [-25, 25], ["10px", "-10px"])

  const scrollToNext = () => {
    const element = document.getElementById("about")
    if (element) {
      element.scrollIntoView({ behavior: "smooth" })
    }
  }

  return (
    <section
      id="home"
      ref={sectionRef}
      className="relative w-full h-screen overflow-hidden"
      style={{
        background: "#2d3134",
        margin: 0,
        padding: 0,
      }}
    >
      {/* Background Image with Parallax */}
      <motion.div className="absolute inset-0 w-full h-full" style={{ y: backgroundY }}>
        <Image
          src="/wood-texture.jpeg"
          alt="Wood texture background"
          fill
          priority
          className="object-cover"
          style={{ objectPosition: "center center" }}
        />
        {/* Rich gradient overlay instead of flat shadow */}
        <div className="absolute inset-0 bg-gradient-to-b from-houtcore-charcoal/30 via-houtcore-charcoal/50 to-houtcore-charcoal/80" />
        <div className="absolute inset-0 bg-gradient-to-r from-houtcore-brown/30 via-transparent to-houtcore-brown/30" />
        
        {/* Subtle pattern overlay with mouse parallax */}
        <div className="absolute inset-0 overflow-hidden">
          <motion.div 
            className="absolute inset-0 opacity-10"
            initial={{ opacity: 0 }}
            animate={{ opacity: 0.1 }}
            transition={{ duration: 2 }}
            style={{
              backgroundImage: "url(\"data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.15' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='1'/%3E%3Ccircle cx='13' cy='13' r='1'/%3E%3C/g%3E%3C/svg%3E\")",
              backgroundSize: "20px 20px",
              x: patternX,
              y: patternY,
              width: "110%",
              height: "110%",
              left: "-5%",
              top: "-5%"
            }}
          />
        </div>
        
        {/* Floating particles for depth - 6 particles instead of 12 */}
        <div className="absolute inset-0 overflow-hidden">
          {[...Array(6)].map((_, index) => (
            <motion.div
              key={index}
              className="absolute rounded-full bg-houtcore-gold/20"
              initial={{
                x: `${Math.random() * 100}%`,
                y: `${Math.random() * 100}%`,
                opacity: 0,
                scale: 0
              }}
              animate={{
                x: [
                  `${Math.random() * 100}%`,
                  `${Math.random() * 100}%`,
                  `${Math.random() * 100}%`
                ],
                y: [
                  `${Math.random() * 100}%`,
                  `${Math.random() * 100}%`,
                  `${Math.random() * 100}%`
                ],
                opacity: [0, 0.3, 0],
                scale: [0, Math.random() * 0.3 + 0.2, 0]
              }}
              transition={{
                duration: Math.random() * 20 + 15,
                repeat: Infinity,
                delay: Math.random() * 5,
                ease: "easeInOut"
              }}
              style={{
                width: `${Math.random() * 10 + 5}px`,
                height: `${Math.random() * 10 + 5}px`,
                filter: "blur(1px)"
              }}
            />
          ))}
        </div>
      </motion.div>

      {/* Main Content Container */}
      <div className="relative z-10 w-full h-full flex flex-col items-center justify-center">
        {/* Logo Section */}
        <motion.div
          className="flex-1 flex items-center justify-center"
          style={{
            y: logoY,
            opacity: logoOpacity,
            scale: logoScale,
          }}
        >
          <motion.div
            style={{
              x: logoX,
              y: logoY2,
            }}
            className="w-full"
          >
            <motion.div
              initial={{ opacity: 0, y: 50 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 1.2, ease: "easeOut" }}
              className="text-center"
            >
              {/* Logo with proper sizing constraints */}
              <div className="mx-auto" style={{ maxWidth: "350px", maxHeight: "200px" }}>
                <Image
                  src="/logo.png"
                  alt="Houtcore Logo"
                  width={350}
                  height={175}
                  className="w-auto h-auto object-contain drop-shadow-xl"
                />
              </div>

              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.6, duration: 1 }}
                className="mt-8"
              >
                <motion.h2 
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.8, duration: 1 }}
                  className="text-houtcore-gold text-xl md:text-2xl font-light tracking-wider"
                >
                  Premium Woodworking
                </motion.h2>
              </motion.div>
            </motion.div>
          </motion.div>
        </motion.div>

        {/* Button Section - Perfectly Centered */}
        <motion.div
          className="absolute bottom-0 left-0 right-0 flex justify-center pb-16"
          style={{
            y: buttonY,
            opacity: buttonOpacity,
          }}
        >
          <motion.button
            onClick={scrollToNext}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 1.2, duration: 0.8 }}
            className="px-6 py-3 bg-transparent border border-houtcore-gold text-houtcore-gold text-base tracking-wide uppercase hover:bg-houtcore-gold/10 transition-all duration-300"
            whileHover={{ scale: 1.05 }}
            whileTap={{ scale: 0.95 }}
          >
            Explore Our Work
          </motion.button>
        </motion.div>

        {/* Scroll Indicator */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ delay: 2, duration: 1 }}
          className="absolute bottom-6 left-1/2 transform -translate-x-1/2"
          style={{
            opacity: useTransform(scrollYProgress, [0, 0.3], [1, 0]),
          }}
        >
          <motion.div
            animate={{ y: [0, 8, 0] }}
            transition={{ duration: 1.5, repeat: Infinity, ease: "easeInOut" }}
            className="flex flex-col items-center cursor-pointer"
            onClick={scrollToNext}
          >
            <span className="text-houtcore-gold text-sm font-light mb-2">Scroll</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              className="text-houtcore-gold w-5 h-5"
            >
              <path d="M12 5v14M5 12l7 7 7-7" />
            </svg>
          </motion.div>
        </motion.div>
      </div>
    </section>
  )
}
